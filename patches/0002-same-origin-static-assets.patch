index 000000000..e51f224f2
--- /dev/null
+++ b/packages/server/resolvePublicPath.ts
@@ -0,0 +1,36 @@
+interface PublicPathOptions {
+  appOrigin: string
+  cdnBaseUrl?: string
+  isProduction: boolean
+  proxyCdn?: string
+  socketPort?: string
+  staticAssetPath?: string
+}
+
+const validateStaticAssetPath = (staticAssetPath: string) => {
+  if (!/^\/(?!\/)[^?#\\]*\/$/.test(staticAssetPath)) {
+    throw new Error(
+      'STATIC_ASSET_PATH must be a same-origin absolute path that starts and ends with "/"'
+    )
+  }
+  return staticAssetPath
+}
+
+export const resolvePublicPath = ({
+  appOrigin,
+  cdnBaseUrl,
+  isProduction,
+  proxyCdn,
+  socketPort,
+  staticAssetPath
+}: PublicPathOptions) => {
+  if (staticAssetPath) return validateStaticAssetPath(staticAssetPath)
+  if (cdnBaseUrl) {
+    if (proxyCdn === 'true') return '/build/'
+    return `${cdnBaseUrl.replace(/^\/{2,}/, 'https://')}/build/`
+  }
+  const url = new URL('/static/', appOrigin)
+  // the webpack dev server uses /static on PORT, so fetch assets at SOCKET_PORT
+  url.port = isProduction ? url.port : socketPort!
+  return url.toString()
+}
